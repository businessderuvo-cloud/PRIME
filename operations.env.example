# Override facoltativi: in produzione backup attivo sul server.
# Se vuota: chiave casuale persistente in backup.key accanto al database.
PRIME_BACKUP_KEY=
# Fly: /data/backups (volume persistente).
PRIME_BACKUP_DIR=
PRIME_BACKUP_RETENTION_DAYS=30
# Copia PC disattivata finché il titolare non collega un dispositivo.
