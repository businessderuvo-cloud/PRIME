# Stripe Connect platform credentials (server only; never request API keys from agencies)
PRIME_STRIPE_TEST_SECRET_KEY=sk_test_replace_me
PRIME_STRIPE_TEST_CONNECT_CLIENT_ID=ca_replace_me
PRIME_STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me
PRIME_STRIPE_LIVE_SECRET_KEY=sk_live_replace_me
PRIME_STRIPE_LIVE_CONNECT_CLIENT_ID=ca_replace_me
PRIME_STRIPE_LIVE_WEBHOOK_SECRET=whsec_replace_me

# Separate webhook for plan checkout TEST (never activates real subscriptions)
PRIME_STRIPE_TEST_BILLING_WEBHOOK_SECRET=whsec_replace_me

# Optional transactional email relay. Keep the Catch Hook URL private.
PRIME_ZAPIER_EMAIL_HOOK_URL=

# Separate Super Admin console. Generate secrets with scripts/create-admin-secrets.mjs.
# Keep these only in the deployment secret store; production requires TOTP.
PRIME_SUPER_ADMIN_EMAIL=
PRIME_SUPER_ADMIN_PASSWORD_HASH=
PRIME_SUPER_ADMIN_TOTP_SECRET=
